# ── Root environment template (Phase 3.5) ──────────────────────────────────
# Copy the relevant blocks into backend/.env and ml-service/.env.
# This file documents every variable the integrated stack needs.

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=marketplace-evidence-photos
S3_UPLOAD_PREFIX=uploads
KMS_KEY_ID=

# Bedrock
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Services — how the three processes find each other
ML_SERVICE_URL=http://localhost:8000
FASTAPI_URL=http://localhost:8000
BACKEND_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5173

# Backend
PORT=5001
NODE_ENV=development

# Auth (Clerk)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Frontend (Vite) — set in frontend/.env
VITE_API_URL=http://localhost:5001/api
